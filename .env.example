# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=rag

# Service settings (RAG_ prefix, see libs/common/src/rag_common/config.py)
RAG_ENVIRONMENT=dev
RAG_LOG_LEVEL=INFO

# OTLP/HTTP collector endpoint for tracing (unset = tracing is a no-op, ADR-0008)
# RAG_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces

# Database URL used by services (asyncpg driver)
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag_dev_password@localhost:5432/rag
# Set to run integration tests against a real Postgres (unset = skipped)
# RAG_TEST_DB_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_test
